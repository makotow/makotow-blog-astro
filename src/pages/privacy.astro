---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const privacy = await getEntry("pages", "privacy");

if (!privacy) {
  throw new Error(
    "Missing content entry: `privacy.md` in `src/content/pages/`"
  );
}

const { Content } = await render(privacy);
const ogImage =
  typeof privacy.data.ogImage === "string"
    ? privacy.data.ogImage
    : privacy.data.ogImage?.src;
---

<Layout
  title={`${privacy.data.title} | ${config.site.title}`}
  description={privacy.data.description}
  {ogImage}
  canonicalURL={privacy.data.canonicalURL}
  lang={privacy.data.lang}
>
  <Header />
  <Breadcrumb />

  <Main pageTitle={privacy.data.title} class="app-prose">
    <Content />
  </Main>

  <Footer />
</Layout>
